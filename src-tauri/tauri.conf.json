{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "SciTrail",
  "version": "0.1.4",
  "identifier": "com.scitrail.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "科迹 SciTrail",
        "width": 1200,
        "height": 800,
        "minWidth": 1000,
        "minHeight": 660,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/stuPETER12138/scitrail/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM2MkRGRkZGQkM0RDI0RUIKUldUckpFMjgvLzh0eHVzZVlSUjcwV1grOVBFQ1JudmhZMmFRZHcrV2o1NFowYlgvMW1DN29NV2MK"
    }
  }
}
